# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (untuk server-side operations - JANGAN expose ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Services
# NOTE: SMTP / Microsoft Graph / Gmail credentials are now managed per-user in the database,
# not via .env. Add/edit them from the dashboard: /dashboard/smtp and /dashboard/providers
# (stored encrypted in Supabase - see SUPABASE_SCHEMA.md sections 3 and 9).
# The variables below are no longer read by the app; kept only as a reference for the fields
# the dashboard forms ask for.

# SMTP Configuration
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password

# Microsoft Graph (OAuth2)
GRAPH_TENANT_ID=common
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# Gmail API
GMAIL_SERVICE_ACCOUNT_JSON={}

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_SECRET is the root key used to encrypt SMTP/Graph/Gmail secrets stored in Supabase
# (src/lib/crypto.ts). Keep it out of source control and never store it in the database itself -
# losing/rotating it makes existing encrypted rows undecryptable.
APP_SECRET=your-super-secret-key-for-sessions
