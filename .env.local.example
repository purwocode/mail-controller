# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (untuk server-side operations - JANGAN expose ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Services (SMTP / Microsoft Graph / Gmail)
# Dikelola per-akun lewat dashboard (/dashboard/smtp dan /dashboard/providers), disimpan
# terenkripsi (AES-256-GCM) di Supabase - lihat SUPABASE_SCHEMA.md bagian 3 & 9.
# Sudah TIDAK dibaca dari .env lagi.

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_SECRET adalah root key untuk enkripsi secret SMTP/Graph/Gmail di database (src/lib/crypto.ts).
# Jangan commit ke git, jangan simpan di database - kalau hilang/diganti, data terenkripsi lama tidak bisa dibaca lagi.
APP_SECRET=your-super-secret-key-for-sessions
